SPACE_ENV=development
SPACE_HTTP_ADDR=:8080
SPACE_DATABASE_URL=postgres://space:space@localhost:5432/space?sslmode=disable
SPACE_LOG_LEVEL=info
SPACE_LOG_FORMAT=json

# Generate each with: openssl rand -base64 32
SPACE_OTP_PEPPER=30JE+JBp4ywh8dxkh0c+Ybh+zDRQxN3k6dk0QwSV2hE=
SPACE_JWT_SEED=
# Generate with: openssl rand -hex 32 (same value in space_web)
SPACE_BFF_SECRET=4b431f83e7a3016b0e25ae825599ea57304cf022e953916f09c5f601d91af1d0
SPACE_SMS_PROVIDER=log
# Development only. Production uses arkesel with real credentials.
SPACE_CORS_ORIGINS=http://localhost:3000

SPACE_DIRECT_CONTACT=true
SPACE_CONTACT_DAILY_CAP=20
SPACE_PAYMENTS_ENABLED=false

SPACE_STORAGE_ENDPOINT=http://localhost:9000
SPACE_STORAGE_REGION=us-east-1
SPACE_STORAGE_BUCKET=space-media
SPACE_STORAGE_ACCESS_KEY=spaceminio
SPACE_STORAGE_SECRET_KEY=spaceminio123
SPACE_STORAGE_PATH_STYLE=true
SPACE_STORAGE_PUBLIC_BASE_URL=http://localhost:9000/space-media
SPACE_MEDIA_MAX_BYTES=10485760
SPACE_MEDIA_MAX_PER_SPACE=20

# Optional routing backend. Missing OSRM leaves walks uncomputed.
SPACE_OSRM_URL=http://localhost:5000

# Production SMS settings (never commit real keys).
# SPACE_SMS_PROVIDER=arkesel
# SPACE_ARKESEL_API_KEY=
# SPACE_SMS_SENDER_ID=Findaspace
# SPACE_ARKESEL_SANDBOX=false

# Only required when explicitly enabling and validating payment flows.
# SPACE_PAYSTACK_SECRET=
# SPACE_PAYSTACK_CALLBACK_URL=

# Optional external providers: IDs must match space_web.
# SPACE_GOOGLE_CLIENT_ID=
# SPACE_MICROSOFT_CLIENT_ID=
# SPACE_APPLE_CLIENT_ID=
