SPACE_ENV=development
SPACE_HTTP_ADDR=:8080
SPACE_DATABASE_URL=postgres://space:space@localhost:5432/space?sslmode=disable
SPACE_LOG_LEVEL=debug
SPACE_LOG_FORMAT=text


secrets: ## print fresh dev secrets for .env
	@echo "SPACE_OTP_PEPPER=$$(openssl rand -base64 32)"
	@echo "SPACE_JWT_SEED=$$(openssl rand -base64 32)"
