# Fill locally or in your host's secret settings. Never commit filled values.
SPACE_ENV=production
SPACE_HTTP_ADDR=:8080
SPACE_LOG_FORMAT=json
SPACE_LOG_LEVEL=info

# Neon PostgreSQL 18: pooled URL for API, direct URL for migrations and River worker.
# Copy both from Neon, retaining sslmode=require (or verify-full).
SPACE_DATABASE_URL=
SPACE_DATABASE_DIRECT_URL=
SPACE_DB_EXEC_MODE=exec
SPACE_DB_MAX_CONNS=10
SPACE_DB_MIN_CONNS=1
SPACE_DB_PING_TIMEOUT=30s

# Separate random base64-encoded 32-byte values: openssl rand -base64 32
SPACE_OTP_PEPPER=
SPACE_JWT_SEED=
# openssl rand -hex 32; same value in frontend
SPACE_BFF_SECRET=
SPACE_CORS_ORIGINS=https://YOUR-FRONTEND-DOMAIN
SPACE_RATELIMIT_ENABLED=true
# Enable only when behind a reverse proxy that replaces forwarded-IP headers.
SPACE_TRUST_PROXY=false

SPACE_SMS_PROVIDER=arkesel
SPACE_ARKESEL_API_KEY=
# Must be registered/approved in Arkesel; 11 characters maximum.
SPACE_SMS_SENDER_ID=Findaspace
SPACE_ARKESEL_SANDBOX=false

# Cloudflare R2 S3 API credentials restricted to this bucket.
SPACE_STORAGE_ENDPOINT=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com
SPACE_STORAGE_REGION=auto
SPACE_STORAGE_BUCKET=findaspace-media
SPACE_STORAGE_ACCESS_KEY=
SPACE_STORAGE_SECRET_KEY=
SPACE_STORAGE_PATH_STYLE=true
# Public/custom bucket domain, NOT the authenticated S3 endpoint.
SPACE_STORAGE_PUBLIC_BASE_URL=https://YOUR-MEDIA-DOMAIN
SPACE_MEDIA_MAX_BYTES=10485760
SPACE_MEDIA_MAX_PER_SPACE=20

SPACE_DIRECT_CONTACT=true
SPACE_CONTACT_DAILY_CAP=20
SPACE_PAYMENTS_ENABLED=false

# Only for cmd/verify. One explicit SMS probe sends one message to this number.
SPACE_VERIFY_WEB_ORIGIN=https://YOUR-FRONTEND-DOMAIN
SPACE_VERIFY_SMS_PHONE=
