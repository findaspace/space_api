{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://YOUR-FRONTEND-DOMAIN"
        ],
        "methods": [
          "PUT",
          "GET",
          "HEAD"
        ],
        "headers": [
          "content-type",
          "range",
          "if-match"
        ]
      },
      "exposeHeaders": [
        "ETag",
        "Content-Range",
        "Content-Length",
        "Accept-Ranges"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
